# Frontend (Vite) — variáveis embutidas no bundle em build time.
# VITE_* são PÚBLICAS. Nunca colocar service_role aqui.

VITE_SUPABASE_URL=https://thjrromvhldqzkzyxwvb.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (Captcha no signup) — opcional em dev.
# Em prod, defina no painel Vercel. Sitekey é público; secret vai no Supabase
# Dashboard → Auth → Bot Protection.
VITE_TURNSTILE_SITEKEY=
